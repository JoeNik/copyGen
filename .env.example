# GitHub OAuth — create at https://github.com/settings/developers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Auth.js session secret — generate with: openssl rand -base64 32
AUTH_SECRET=

# Development only. When set to "true" and NODE_ENV is not "production",
# the AI proxy allows outbound requests to private/loopback/local-link
# addresses (e.g. a local LLM on http://127.0.0.1:11434).
# Has NO effect in production — private addresses are always blocked there.
AI_ALLOW_PRIVATE_NETWORK=false
